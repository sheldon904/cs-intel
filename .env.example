# ---------------------------------------------------------------------------
# cs-intel environment configuration
#
# EVERYTHING RUNS WITHOUT KEYS. If no LLM key is present the pipeline falls
# back to a deterministic heuristic labeler / agent so `docker compose up`
# produces a fully working dashboard offline. Add keys to exercise the real
# LLM + tracing paths.
# ---------------------------------------------------------------------------

# LLM provider: "anthropic" | "openai" | "mock"
# "mock" (or a missing key) => deterministic offline mode.
CS_INTEL_LLM_PROVIDER=mock

# Anthropic
ANTHROPIC_API_KEY=
CS_INTEL_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# OpenAI (optional alternative)
OPENAI_API_KEY=
CS_INTEL_OPENAI_MODEL=gpt-4o-mini

# ---- Langfuse (LLMOps tracing) -------------------------------------------
# Leave blank to disable tracing. Point at Langfuse cloud or a self-hosted
# instance (the docker-compose file can spin one up locally).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---- Data generation -----------------------------------------------------
CS_INTEL_SEED=42
CS_INTEL_N_ACCOUNTS=500
CS_INTEL_N_MONTHS=24
